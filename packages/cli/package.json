{
  "name": "@kurotako/cli",
  "version": "0.1.0",
  "description": "The tako command-line interface for kurotako.",
  "keywords": [
    "kurotako",
    "codegen",
    "typescript",
    "cli",
    "tako"
  ],
  "license": "MIT",
  "author": "Marmotz",
  "homepage": "https://kurotako.marmotz.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotz/kurotako.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/marmotz/kurotako/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tako": "./dist/bin/tako.js"
  },
  "dependencies": {
    "@kurotako/config": "workspace:^",
    "@kurotako/core": "workspace:^",
    "chokidar": "^4",
    "citty": "0.1.6"
  },
  "devDependencies": {
    "@kurotako/gen-zod": "workspace:^",
    "@kurotako/parser-prisma": "workspace:^"
  }
}
