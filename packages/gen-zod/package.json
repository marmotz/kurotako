{
  "name": "@kurotako/gen-zod",
  "version": "0.1.0",
  "description": "kurotako generator that emits Zod schemas from the intermediate representation.",
  "keywords": [
    "kurotako",
    "codegen",
    "typescript",
    "zod",
    "generator"
  ],
  "license": "MIT",
  "author": "Marmotz",
  "homepage": "https://kurotako.marmotz.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotz/kurotako.git",
    "directory": "packages/gen-zod"
  },
  "bugs": "https://github.com/marmotz/kurotako/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kurotako/ir": "workspace:^",
    "valibot": "1.4.2"
  },
  "peerDependencies": {
    "@kurotako/config": "workspace:^",
    "@kurotako/core": "workspace:^"
  },
  "devDependencies": {
    "@kurotako/config": "workspace:^",
    "@kurotako/core": "workspace:^"
  }
}
