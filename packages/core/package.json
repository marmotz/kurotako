{
  "name": "@kurotako/core",
  "version": "0.1.0",
  "description": "kurotako pipeline core: dependency DAG, topological ordering and the parser/generator contracts.",
  "keywords": [
    "kurotako",
    "codegen",
    "typescript",
    "pipeline",
    "dag"
  ],
  "license": "MIT",
  "author": "Marmotz",
  "homepage": "https://kurotako.marmotz.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marmotz/kurotako.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/marmotz/kurotako/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kurotako/ir": "workspace:^",
    "tsup": "8.5.1"
  }
}
