{
  "name": "@kurotako/ir",
  "version": "0.1.0",
  "description": "Intermediate representation for kurotako: the schema model parsers produce and generators consume.",
  "keywords": [
    "kurotako",
    "codegen",
    "typescript",
    "schema",
    "ir",
    "valibot"
  ],
  "license": "MIT",
  "author": "Marmotz",
  "homepage": "https://kurotako.marmotz.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/marmotz/kurotako.git",
    "directory": "packages/ir"
  },
  "bugs": "https://github.com/marmotz/kurotako/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "valibot": "1.4.2"
  }
}
