{
  "name": "kurotako-example-openapi-outputpkg",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@kurotako/cli": "link:@kurotako/cli",
    "@kurotako/config": "link:@kurotako/config",
    "@kurotako/parser-openapi": "link:@kurotako/parser-openapi",
    "@kurotako/gen-zod": "link:@kurotako/gen-zod",
    "@kurotako/gen-angular": "link:@kurotako/gen-angular",
    "@kurotako/gen-typescript": "link:@kurotako/gen-typescript",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "zod": "^4"
  },
  "scripts": {
    "bootstrap": "mkdir -p packages/example-tasks && printf '{\\n  \"name\": \"@example/tasks\",\\n  \"version\": \"0.0.0\",\\n  \"//\": \"Generated by tako. Do not edit. Placeholder overwritten by the first `tako generate`.\"\\n}\\n' > packages/example-tasks/package.json && bun install",
    "openapi:emit": "cd apps/backend && bun run openapi:emit",
    "tako:generate": "tako generate"
  }
}
